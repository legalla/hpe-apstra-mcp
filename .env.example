# Copier ce fichier en .env et renseigner les valeurs

# Controleur Apstra
APSTRA_HOST=192.168.1.100
APSTRA_USERNAME=admin
APSTRA_PASSWORD=secret
APSTRA_VERIFY_SSL=false

# Transport MCP : "sse" (reseau/Docker) ou "stdio" (local)
MCP_TRANSPORT=sse
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Authentification Bearer du client MCP vers le serveur (optionnelle, OFF par defaut)
# Passer a true apres avoir cree au moins un token :
#   docker compose exec hpe-apstra-mcp python apstra_token_manager.py generate --name <client>
APSTRA_AUTH_ENABLED=false
APSTRA_TOKENS_FILE=/app/secrets/.tokens
# Mettre a true UNIQUEMENT derriere un reverse-proxy de confiance
APSTRA_TRUST_FORWARDED_FOR=false
