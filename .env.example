# Copy this file to .env and fill in the values

# Apstra controller
APSTRA_HOST=192.168.1.100
APSTRA_USERNAME=admin
APSTRA_PASSWORD=secret
APSTRA_VERIFY_SSL=false

# MCP transport: "sse" (network/Docker) or "stdio" (local)
MCP_TRANSPORT=sse
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Bearer authentication of the MCP client to the server (optional, OFF by default)
# Set to true after creating at least one token:
#   docker compose exec hpe-apstra-mcp python apstra_token_manager.py generate --name <client>
APSTRA_AUTH_ENABLED=false
APSTRA_TOKENS_FILE=/app/secrets/.tokens
# Set to true ONLY behind a trusted reverse-proxy
APSTRA_TRUST_FORWARDED_FOR=false

# Allow write tools (create/update/delete, commit, rollback, revert).
# false = read-only server (default). Set to true knowingly.
APSTRA_WRITE_ENABLED=false

# Collapse the 61 atomic tools into 12 scope/action flat dispatchers (see
# dispatch/flat_tools.py). false = legacy full toolset (default).
APSTRA_FLAT_TOOLSET=false
